# ReplicantOS operator configuration. This file contains no credentials.
# Copy it to .env for a local source build; .env is ignored by Git.

# The bundled HTTP server intentionally listens on loopback only.
REPLICANTOS_HOST=127.0.0.1
REPLICANTOS_PORT=8787

# This must be the exact browser origin, with no path or trailing slash.
# Keep this loopback value for local use. For an HTTPS reverse proxy, replace
# it with the proxy's one public HTTPS origin and keep the host on loopback.
REPLICANTOS_ALLOWED_ORIGINS=http://127.0.0.1:8787

# Relative paths are resolved from the repository root.
REPLICANTOS_DATA_DIR=./data

# Provider credentials are deliberately absent. Authenticate each local agent
# harness with its own supported host-native login before starting ReplicantOS.

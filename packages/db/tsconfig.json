{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true,
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@replicantos/core": ["../core/src/index.ts"],
      "@replicantos/runtime": ["../runtime/src/index.ts"]
    }
  },
  "references": [{ "path": "../core" }, { "path": "../runtime" }],
  "include": ["src/**/*.ts"]
}

{
  "name": "@replicantos/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restart-safe schedule and harness run coordination for ReplicantOS.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "format:check": "prettier --check .",
    "lint": "tsc -b tsconfig.json --pretty false",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@replicantos/harnesses": "workspace:*",
    "@replicantos/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}
